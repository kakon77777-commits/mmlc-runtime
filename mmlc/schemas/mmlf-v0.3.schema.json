{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/mmlf-v0.3.schema.json",
  "title": "MMLF v0.3",
  "type": "object",
  "required": ["format", "version", "ledger_id", "branches"],
  "properties": {
    "format": {"const": "MMLF"},
    "version": {"type": ["string", "number"]},
    "ledger_id": {"type": "string", "minLength": 1},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "value"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "value": {},
          "metadata": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "operator"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_id": {"type": ["string", "null"]},
          "base": {},
          "operator": {"type": "string", "minLength": 1},
          "operand": {},
          "expected_result": {},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "context": {"type": "object"},
          "region": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {"type": ["string", "null"]}
      }
    },
    "traversals": {
      "type": "object",
      "properties": {
        "display": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "execute": {"type": "string"},
        "audit": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        }
      },
      "additionalProperties": true
    },
    "audit_policy": {
      "type": "object",
      "properties": {
        "local_required": {"type": "boolean"},
        "signed_global_cancellation_allowed": {"type": "boolean"},
        "numeric_tolerance": {"type": "number", "minimum": 0},
        "required_checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "boundary_events": {"type": "array", "items": {"type": "object"}},
    "evaluation_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "bindings"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "bindings": {"type": "object"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
