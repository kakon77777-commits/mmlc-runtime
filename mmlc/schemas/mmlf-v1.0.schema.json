{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efficientnewlanguage.org/schemas/mmlf-v1.0.schema.json",
  "title": "MMLF v1.0 Stable",
  "type": "object",
  "required": [
    "format",
    "version",
    "ledger_id",
    "branches"
  ],
  "properties": {
    "format": {
      "const": "MMLF"
    },
    "version": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^1\\.0(?:\\.\\d+)?$"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "base": {},
          "operator": {
            "type": "string",
            "minLength": 1
          },
          "operand": {},
          "expected_result": {},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context": {
            "type": "object"
          },
          "region": {
            "type": "string"
          },
          "time_index": {
            "type": "integer",
            "minimum": 0
          },
          "series_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "traversals": {
      "type": "object",
      "properties": {
        "display": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "execute": {
          "type": "string"
        },
        "audit": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "audit_policy": {
      "type": "object",
      "properties": {
        "local_required": {
          "type": "boolean"
        },
        "signed_global_cancellation_allowed": {
          "type": "boolean"
        },
        "numeric_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "boundary_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evaluation_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "bindings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bindings": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sum_equals",
              "all_equal"
            ]
          },
          "field": {
            "enum": [
              "result",
              "audited_result"
            ]
          },
          "target": {},
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "metadata": {
            "type": "object"
          },
          "scope": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "row",
                  "column",
                  "block",
                  "cells",
                  "region"
                ]
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "row_start": {
                "type": "integer",
                "minimum": 0
              },
              "row_end": {
                "type": "integer",
                "minimum": 1
              },
              "column_start": {
                "type": "integer",
                "minimum": 0
              },
              "column_end": {
                "type": "integer",
                "minimum": 1
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "region": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "row"
                    }
                  }
                },
                "then": {
                  "required": [
                    "index"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "column"
                    }
                  }
                },
                "then": {
                  "required": [
                    "index"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "block"
                    }
                  }
                },
                "then": {
                  "required": [
                    "row_start",
                    "row_end",
                    "column_start",
                    "column_end"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "cells"
                    }
                  }
                },
                "then": {
                  "required": [
                    "ids"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "region"
                    }
                  }
                },
                "then": {
                  "required": [
                    "region"
                  ]
                }
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "fixed_point_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "method": {
            "enum": [
              "jacobi"
            ]
          },
          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1
          },
          "initial_values": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_tx_id",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target_tx_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "enum": [
              "declared_result",
              "expected_result"
            ]
          },
          "mode": {
            "enum": [
              "replace",
              "delta"
            ]
          },
          "value": {},
          "reason": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "fdcs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "context": {
          "type": "string"
        },
        "base_context": {
          "type": "string",
          "minLength": 1
        },
        "decay_lambda": {
          "type": "number",
          "minimum": 0
        },
        "fractal_decay_lambda": {
          "type": "number",
          "minimum": 0
        },
        "context_modulation": {
          "type": "number",
          "minimum": 0
        },
        "parallel_workers": {
          "type": "integer",
          "minimum": 1
        },
        "direction_weights": {
          "type": "object",
          "properties": {
            "forward": {
              "type": "number",
              "minimum": 0
            },
            "reverse": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "interventions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "target_tx_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "do_set",
                  "soft_shift",
                  "soft_scale",
                  "soft_affine"
                ]
              },
              "target_tx_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "scale": {},
              "shift": {},
              "reason": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "modulation": {
                "type": "number",
                "minimum": 0
              },
              "interventions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "target_tx_id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "do_set",
                        "soft_shift",
                        "soft_scale",
                        "soft_affine"
                      ]
                    },
                    "target_tx_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {},
                    "scale": {},
                    "shift": {},
                    "reason": {
                      "type": "string"
                    },
                    "metadata": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "metadata": {
                "type": "object"
              },
              "probability": {
                "type": "number",
                "minimum": 0
              },
              "policy_id": {
                "type": "string",
                "minLength": 1
              },
              "scenario_id": {
                "type": "string",
                "minLength": 1
              },
              "cost": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "observed_transactions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "probability_model": {
          "type": "object",
          "properties": {
            "tolerance": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "policy_selection": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "risk_aversion": {
              "type": "number",
              "minimum": 0
            },
            "cost_weight": {
              "type": "number",
              "minimum": 0
            },
            "tie_tolerance": {
              "type": "number",
              "minimum": 0
            },
            "objectives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "tx_id"
                ],
                "properties": {
                  "tx_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "number"
                  },
                  "direction": {
                    "enum": [
                      "maximize",
                      "minimize"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "observation_planning": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "candidate_transactions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "max_additional_observations": {
              "type": "integer",
              "minimum": 0
            },
            "max_candidates": {
              "type": "integer",
              "minimum": 1
            },
            "max_solutions": {
              "type": "integer",
              "minimum": 1
            },
            "observation_costs": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "additionalProperties": false
        },
        "continuous_uncertainty": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "samples": {
              "type": "integer",
              "minimum": 4
            },
            "max_samples": {
              "type": "integer",
              "minimum": 4
            },
            "ensembles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "variables"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "policy_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scenario_prefix": {
                    "type": "string",
                    "minLength": 1
                  },
                  "samples": {
                    "type": "integer",
                    "minimum": 4
                  },
                  "cost": {
                    "type": "number",
                    "minimum": 0
                  },
                  "modulation": {
                    "type": "number",
                    "minimum": 0
                  },
                  "correlation_matrix": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      }
                    }
                  },
                  "variables": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "target_tx_id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "target_tx_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "distribution": {
                          "enum": [
                            "normal",
                            "uniform",
                            "triangular",
                            "lognormal"
                          ]
                        },
                        "intervention_kind": {
                          "enum": [
                            "do_set",
                            "soft_shift",
                            "soft_scale"
                          ]
                        },
                        "mean": {
                          "type": "number"
                        },
                        "stddev": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "lower": {
                          "type": "number"
                        },
                        "upper": {
                          "type": "number"
                        },
                        "mode": {
                          "type": "number"
                        },
                        "mu": {
                          "type": "number"
                        },
                        "sigma": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "mean_log": {
                          "type": "number"
                        },
                        "stddev_log": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "information_value": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "horizon": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "max_horizon": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "max_candidates": {
              "type": "integer",
              "minimum": 1
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            },
            "policy_cost_weight": {
              "type": "number",
              "minimum": 0
            },
            "candidate_transactions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "observation_costs": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "objectives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "tx_id"
                ],
                "properties": {
                  "tx_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weight": {
                    "type": "number"
                  },
                  "direction": {
                    "enum": [
                      "maximize",
                      "minimize"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "migrated_from": {
          "type": "string"
        },
        "migrated_by": {
          "type": "string"
        },
        "migration_profile": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "description": "Stable MMLF 1.0 schema for MMLC Runtime 1.x. Computational semantics are frozen from Runtime 0.9 unless a future 2.0 migration explicitly changes them."
}
