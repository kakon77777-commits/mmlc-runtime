{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/mmlf-v0.4.schema.json",
  "title": "MMLF v0.4",
  "type": "object",
  "required": [
    "format",
    "version",
    "ledger_id",
    "branches"
  ],
  "properties": {
    "format": {
      "const": "MMLF"
    },
    "version": {
      "type": [
        "string",
        "number"
      ]
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "base": {},
          "operator": {
            "type": "string",
            "minLength": 1
          },
          "operand": {},
          "expected_result": {},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context": {
            "type": "object"
          },
          "region": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "traversals": {
      "type": "object",
      "properties": {
        "display": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "execute": {
          "type": "string"
        },
        "audit": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "audit_policy": {
      "type": "object",
      "properties": {
        "local_required": {
          "type": "boolean"
        },
        "signed_global_cancellation_allowed": {
          "type": "boolean"
        },
        "numeric_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "boundary_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evaluation_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "bindings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bindings": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sum_equals",
              "all_equal"
            ]
          },
          "field": {
            "enum": [
              "result",
              "audited_result"
            ]
          },
          "target": {},
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "metadata": {
            "type": "object"
          },
          "scope": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "row",
                  "column",
                  "block",
                  "cells",
                  "region"
                ]
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "row_start": {
                "type": "integer",
                "minimum": 0
              },
              "row_end": {
                "type": "integer",
                "minimum": 1
              },
              "column_start": {
                "type": "integer",
                "minimum": 0
              },
              "column_end": {
                "type": "integer",
                "minimum": 1
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "region": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "row"
                    }
                  }
                },
                "then": {
                  "required": [
                    "index"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "column"
                    }
                  }
                },
                "then": {
                  "required": [
                    "index"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "block"
                    }
                  }
                },
                "then": {
                  "required": [
                    "row_start",
                    "row_end",
                    "column_start",
                    "column_end"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "cells"
                    }
                  }
                },
                "then": {
                  "required": [
                    "ids"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "region"
                    }
                  }
                },
                "then": {
                  "required": [
                    "region"
                  ]
                }
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}